---
import {
	getEmDashCollection,
	getEmDashEntry,
	getMenuWithCacheHint,
	getSiteSettingsWithCacheHint,
} from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { getSiteLocale } from "../utils/locale";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/organic.css";
import "../styles/theme.css";
import "../styles/custom.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, robots, type = "website", content } = Astro.props;

const [settingsResult, menuResult, toursResult, contactResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getEmDashCollection("tours", { orderBy: { sort_order: "asc" } }),
	getEmDashEntry("pages", "contact"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(toursResult.cacheHint);
	if (contactResult.cacheHint) Astro.cache.set(contactResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settingsResult.data);
const fullTitle = title === siteTitle || title.endsWith(` — ${siteTitle}`) ? title : `${title} — ${siteTitle}`;
const menuItems = menuResult.data?.items ?? [];
const tours = toursResult.entries ?? [];
const contactItems = (contactResult.entry?.data.items ?? []).filter((i: any) => i.url);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
function navCurrent(url: string) {
	try {
		const t = new URL(url, Astro.url);
		if (t.hash) return currentPath.startsWith("/hikes") && t.hash === "#hikes" ? "true" : undefined;
		const path = t.pathname.replace(/\/$/, "") || "/";
		return path === currentPath ? "page" : undefined;
	} catch {
		return undefined;
	}
}
const lang = getSiteLocale() ?? "en";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-heading" preload />
		<link rel="icon" href="/assets/images/DH_logo.svg" type="image/svg+xml" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="btn btn-primary skip-link">Skip to content</a>
		<header class="site-header wrap">
			<nav class="site-nav" aria-label="Main">
				<a href="/" class="site-nav__brand">
					<img src="/assets/images/DH_logo.svg" alt={siteTitle} width="176" height="auto" />
				</a>
				<ul>
					{menuItems.map((item) => (
						<li>
							<a href={item.url} target={item.target} aria-current={navCurrent(item.url)}>{item.label}</a>
						</li>
					))}
				</ul>
				<a class="btn btn-primary" href="/contact" style="padding: 11px 20px">Plan a hike</a>
			</nav>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer wrap">
			<div class="site-footer__card">
				<div class="site-footer__col">
					<img src="/assets/images/DH_logo.svg" alt={siteTitle} width="120" height="120" />
					{siteTagline && <span style="font-size: 14px">{siteTagline}</span>}
				</div>
				{tours.length > 0 && (
					<nav class="site-footer__col" aria-labelledby="footer-hikes">
						<h2 id="footer-hikes">Hikes</h2>
						{tours.map((t) => <a href={`/hikes/${t.id}`}>{t.data.title}</a>)}
					</nav>
				)}
				<nav class="site-footer__col" aria-labelledby="footer-company">
					<h2 id="footer-company">Company</h2>
					{menuItems.filter((i) => !i.url.includes("#")).map((item) => <a href={item.url}>{item.label}</a>)}
				</nav>
				{contactItems.length > 0 && (
					<div class="site-footer__col">
						<h2>Get in touch</h2>
						{contactItems.map((i: any) => <a href={i.url}>{i.text}</a>)}
					</div>
				)}
			</div>
			<p class="site-footer__meta">© {year} {siteTitle} · Kirra, Phocis, Greece</p>
			<div class="footerCredit">
				Designed & developed by <a href="https://www.bluebell.gr" rel="noopener noreferrer" target="_blank">bluebell</a>
			</div>
		</footer>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
