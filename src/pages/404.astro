---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found">
	<section class="wrap" style="padding-top: 60px">
		<span class="tag tag-accent kicker">404</span>
		<h1 class="h-display">This trail doesn't exist.</h1>
		<p class="lead">The page you're looking for has moved or never existed.</p>
		<div class="actions" style="margin-top: 20px"><a class="btn btn-primary btn-lg" href="/">Back to the homepage</a></div>
	</section>
</Base>
