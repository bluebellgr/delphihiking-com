---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import TourCard from "../components/TourCard.astro";
import Icon from "../components/Icon.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [homeResult, toursResult, guidesResult, settings] = await Promise.all([
	getEmDashEntry("pages", "home"),
	getEmDashCollection("tours", { orderBy: { sort_order: "asc" } }),
	getEmDashCollection("guides", { orderBy: { sort_order: "asc" } }),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) {
	if (homeResult.cacheHint) Astro.cache.set(homeResult.cacheHint);
	Astro.cache.set(toursResult.cacheHint);
	Astro.cache.set(guidesResult.cacheHint);
}
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
const home = homeResult.entry;
const h = home?.data;
const tours = toursResult.entries;
const guides = guidesResult.entries.filter((g) => g.data.photo).slice(0, 2);
---

<Base title={siteTitle} description={h?.lead ?? siteTagline}>
	{h && (
		<section class="wrap" style="padding-top: 24px">
			{h.hero_image && (
				<div class="media washed hero__image" {...home.edit.hero_image}>
					<Image image={h.hero_image} priority />
				</div>
			)}
			<div class="hero__panel">
				{h.kicker && <span class="tag tag-accent-2 kicker" {...home.edit.kicker}>{h.kicker}</span>}
				<h1 class="h-display" {...home.edit.title}>{h.title}</h1>
				{h.lead && <p class="lead" style="margin-bottom: 24px" {...home.edit.lead}>{h.lead}</p>}
				<div class="actions">
					<a class="btn btn-primary btn-lg" href="#hikes">See the hikes</a>
					<a class="btn btn-secondary btn-lg" href="/contact">Ask us anything</a>
				</div>
			</div>
		</section>
	)}

	{h?.intro && (
		<section class="wrap section split">
			{h.intro_heading && <h2 class="h-section" style="max-width: 420px" {...home.edit.intro_heading}>{h.intro_heading}</h2>}
			<p class="intro-text" {...home.edit.intro}>{h.intro}</p>
		</section>
	)}

	<section id="hikes" class="wrap section" style="scroll-margin-top: 24px">
		<div class="section-head">
			<h2 class="h-section">Hikes from Delphi</h2>
			<p class="muted" style="margin: 0; max-width: 380px">Transport from Delphi, Chrisso or Itea is included on every hike except the Ancient Path, which starts on foot in Delphi.</p>
		</div>
		{tours.length === 0 ? (
			<p>No hikes yet. <a href="/_emdash/admin/content/tours/new">Add one in the admin.</a></p>
		) : (
			<div class="tour-grid">{tours.map((t) => <TourCard tour={t} />)}</div>
		)}
	</section>

	{h?.items?.length > 0 && (
		<section class="wrap section">
			<h2 class="h-section" style="margin-bottom: 28px">What every hike includes</h2>
			<div class="included">
				<div class="included__list" {...home.edit.items}>
					<ul>
						{h.items.map((i: any) => (
							<li>
								<span class="check"><Icon name="check" size={15} /></span>
								<span><strong>{i.title}</strong>{i.text}</span>
							</li>
						))}
					</ul>
				</div>
				{h.content?.length > 0 && (
					<div class="not-included" {...home.edit.content}>
						<h3 style="font-size: 22px; margin-bottom: 14px">Not included</h3>
						<PortableText value={h.content} />
					</div>
				)}
			</div>
		</section>
	)}

	{h?.cta_heading && (
		<section class="wrap section">
			<div class="band-navy split split--center">
				<div>
					<span class="tag tag-gold kicker">On demand</span>
					<h2 class="h-section" style="margin: 16px 0 14px" {...home.edit.cta_heading}>{h.cta_heading}</h2>
					{h.cta_text && <p style="font-size: 18px; margin: 0; max-width: 520px" {...home.edit.cta_text}>{h.cta_text}</p>}
				</div>
				<div><a class="btn btn-cream btn-lg" href="/contact?tour=custom">Ask about a custom route</a></div>
			</div>
		</section>
	)}

	{guides.length === 2 && (
		<section class="wrap section split split--center">
			<div class="duo">
				<div class="media washed duo__a"><Image image={guides[0].data.photo} /></div>
				<div class="media washed duo__b"><Image image={guides[1].data.photo} /></div>
			</div>
			<div>
				<span class="tag tag-accent kicker">Your guides</span>
				<h2 class="h-section" style="margin: 14px 0">Two locals from Kirra.</h2>
				<p style="font-size: 18px">{guides.map((g) => g.data.title).join(" and ")} were born and live in Kirra, and know these mountains from the smallest hills to the highest peaks.</p>
				<a class="btn btn-secondary" href="/about" style="font-size: 15px; padding: 12px 22px">Meet us</a>
			</div>
		</section>
	)}
</Base>
