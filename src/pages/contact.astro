---
import { getEmDashEntry, getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [{ entry: page, cacheHint }, toursResult, settings] = await Promise.all([
	getEmDashEntry("pages", "contact"),
	getEmDashCollection("tours", { orderBy: { sort_order: "asc" } }),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) { if (cacheHint) Astro.cache.set(cacheHint); Astro.cache.set(toursResult.cacheHint); }
const { siteTitle } = resolveBlogSiteIdentity(settings);
const d = page?.data;
const tours = toursResult.entries;
const selected = Astro.url.searchParams.get("tour") ?? "";
const sent = Astro.url.searchParams.has("sent");
const failed = Astro.url.searchParams.has("error");
const sel = tours.find((t) => t.id === selected);
const sizeHint = sel ? (sel.data.group_size ?? "") : "e.g. 4";
const iconFor = (title: string) => (/mail/i.test(title) ? "mail" : /viber|chat/i.test(title) ? "chat" : "phone");
---

<Base title={d?.title ?? "Contact"} description={d?.lead}>
	<section class="wrap" style="padding-top: 40px">
		<div class="split" style="align-items: start">
			<div>
				{d?.kicker && <span class="tag tag-accent-2 kicker">{d.kicker}</span>}
				<h1 class="h-display" {...page?.edit.title}>{d?.title ?? "Contact"}</h1>
				{d?.lead && <p class="lead" style="font-size: 19px; margin-bottom: 32px" {...page?.edit.lead}>{d.lead}</p>}
				<div class="contact-list" {...page?.edit.items}>
					{(d?.items ?? []).map((i: any) => {
						const Tag = i.url ? "a" : "div";
						return (
							<Tag class="contact-item" href={i.url}>
								<span class="contact-item__icon"><Icon name={iconFor(i.title)} size={20} /></span>
								<span><span class="contact-item__label">{i.title}</span><span class="contact-item__value">{i.text}</span></span>
							</Tag>
						);
					})}
				</div>
			</div>

			<div id="form" class="form-card">
				{sent && <p class="alert alert--ok" role="status"><strong>Thanks, your inquiry is on its way.</strong> We'll get back to you by email.</p>}
				{failed && <p class="alert alert--err" role="alert">Something went wrong sending your inquiry. Please email us directly.</p>}
				<form class="form" method="post" action="/api/inquiry">
					<div class="field"><label for="f-name">Name</label><input id="f-name" name="name" class="input" required autocomplete="name" /></div>
					<div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" class="input" required autocomplete="email" /></div>
					<div class="field full">
						<label for="f-tour">Hike</label>
						<select id="f-tour" name="tour" class="input">
							<option value="">Not sure yet</option>
							{tours.map((t) => <option value={t.data.title} selected={t.id === selected}>{t.data.title}</option>)}
							<option value="Custom route" selected={selected === "custom"}>Custom route (Parnassus, Giona, Oiti, Helicon)</option>
						</select>
					</div>
					<div class="field"><label for="f-date">Preferred date</label><input id="f-date" name="date" type="date" class="input" /></div>
					<div class="field"><label for="f-size">Group size</label><input id="f-size" name="size" type="number" min="1" class="input" placeholder={sizeHint} /></div>
					<div class="field full"><label for="f-msg">Message</label><textarea id="f-msg" name="message" class="input" rows="5"></textarea></div>
					<input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
					<div class="full"><button class="btn btn-primary btn-lg" type="submit">Send inquiry</button></div>
				</form>
			</div>
		</div>
	</section>
</Base>
