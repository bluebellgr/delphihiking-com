									"alt": "The Ancient Path: Delphi to Kirra",
									"filename": "tours-ancient-path-3.jpg"
								}
							}
						},
						{
							"image": {
								"$media": {
									"url": "https://delphihiking.com/assets/tours/ancient-path/4.jpg",
									"alt": "The Ancient Path: Delphi to Kirra",
									"filename": "tours-ancient-path-4.jpg"
								}
							}
						}
					],
					"distance": "10 km",
					"elevation": "+7 m / −540 m",
					"hiking_time": "3 h 30 min incl. stops",
					"total_time": "Around 3.5 hours",
					"terrain": "Rocky mountain path",
					"departure": "9:00 am at the Flag Spot of Delphi",
					"ages": "8+",
					"fitness": "Average and above",
					"story_heading": "Historical significance",
					"story": [
						{
							"heading": "Pilgrim gateway",
							"text": "In ancient times, travelers, priests, and merchants arriving by sea docked at Kirra and walked this path upward to consult the Pythia."
						},
						{
							"heading": "Modern trail",
							"text": "Today, the route forms a portion of the European long-distance E4 footpath."
						}
					],
					"highlights": [
						{
							"text": "Following the ancient pilgrims' steps"
						},
						{
							"text": "Walk inside the ancient Crisaean olive grove, listed by UNESCO as a unique landscape of more than 1.5 million olive trees"
						},
						{
							"text": "Beautiful view of Kirra and Itea, and the entire olive grove from above"
						},
						{
							"text": "Part of the E4 European path"
						}
					],
					"equipment": [
						{
							"item": "Hiking shoes (obligatory)"
						},
						{
