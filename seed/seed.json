				"id": "tour-herakles-pyre",
				"slug": "herakles-pyre",
				"status": "published",
				"data": {
					"title": "Herakles' Pyre",
					"lede": "Hike Mount Oiti's fir forests to the spot where Herakles' funeral pyre was lit, and up to the 1,565 m Pyrgaki peak.",
					"difficulty": "MEDIUM",
					"group_size": "2–7 people",
					"sort_order": 3,
					"from_price": 120,
					"transport_included": true,
					"cover": {
						"$media": {
							"url": "https://delphihiking.com/assets/tours/herakles/5.jpg",
							"alt": "Herakles' Pyre",
							"filename": "tours-herakles-5.jpg"
						}
					},
					"gallery": [
						{
							"image": {
								"$media": {
									"url": "https://delphihiking.com/assets/tours/herakles/1.jpg",
									"alt": "Herakles' Pyre",
