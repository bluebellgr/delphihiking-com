						{
							"image": {
								"$media": {
									"url": "https://delphihiking.com/assets/tours/herakles/3.jpg",
									"alt": "Herakles' Pyre",
									"filename": "tours-herakles-3.jpg"
								}
							}
						},
						{
							"image": {
								"$media": {
									"url": "https://delphihiking.com/assets/tours/herakles/4.jpg",
									"alt": "Herakles' Pyre",
									"filename": "tours-herakles-4.jpg"
								}
							}
						}
					],
					"distance": "9.5 km",
					"elevation": "+640 m / −590 m",
					"hiking_time": "4 h 30 min incl. stops",
					"total_time": "Around 7.5–8 hours incl. transport and stops",
					"terrain": "Fir forest hiking path",
					"departure": "8:00 am at the appointed location (Delphi, Chrisso or Itea)",
					"ages": "8+",
					"fitness": "Good and above",
					"story_heading": "Mythology and history",
					"story": [
						{
							"heading": "The myth",
							"text": "According to Greek mythology, this is the exact spot where the funeral pyre was lit for Heracles. He threw himself into the flames to escape the agonizing pain caused by the poisoned Shirt of Nessus, given to him by his wife Deianira. As the flames rose, Zeus struck the pyre with a thunderbolt and elevated his son to Mount Olympus to become immortal."
						},
						{
							"heading": "The sanctuary",
							"text": "A prostyle Doric temple dedicated to the worship of Heracles was built here, dating back to the 6th century BC. The site remained an active place of worship with various reconstructions until the Roman period."
						},
						{
							"heading": "Excavations",
							"text": "The site was excavated in 1920 by archaeologist Nikos Papadakis. The digs uncovered clay and bronze votive offerings (including small figurines of Heracles), coins, and inscriptions referencing the \"Oitea Herakleia\" festivals celebrated in honor of the deified hero."
						}
					],
					"highlights": [
						{
							"text": "The ancient sanctuary of Herakles Pyre"
						},
						{
							"text": "Mountain peak \"Pyrgaki\" at 1,565 m altitude"
						},
						{
							"text": "See free horses (if they are in the area)"
						},
						{
							"text": "Amazing fir forest hike"
						}
					],
