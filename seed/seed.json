			{
				"id": "tour-corycian-cave",
				"slug": "corycian-cave",
				"status": "published",
				"data": {
					"title": "Corycian Cave",
					"lede": "Climb through fir forest to the sacred cave of Pan and the Nymphs, with Delphi far below.",
					"difficulty": "MEDIUM",
					"group_size": "2–7 people",
					"sort_order": 2,
					"from_price": 110,
					"transport_included": true,
					"cover": {
						"$media": {
							"url": "https://delphihiking.com/assets/tours/corycian/2.jpg",
							"alt": "Corycian Cave",
							"filename": "tours-corycian-2.jpg"
						}
					},
					"gallery": [
						{
							"image": {
								"$media": {
									"url": "https://delphihiking.com/assets/tours/corycian/1.jpg",
									"alt": "Corycian Cave",
									"filename": "tours-corycian-1.jpg"
								}
							}
						},
						{
							"image": {
								"$media": {
									"url": "https://delphihiking.com/assets/tours/corycian/3.jpg",
									"alt": "Corycian Cave",
									"filename": "tours-corycian-3.jpg"
								}
							}
						},
						{
							"image": {
								"$media": {
									"url": "https://delphihiking.com/assets/tours/corycian/4.jpg",
									"alt": "Corycian Cave",
									"filename": "tours-corycian-4.jpg"
								}
							}
						}
					],
					"distance": "13 km",
					"elevation": "+330 m / −900 m",
					"hiking_time": "5 h 30 min incl. stops",
					"total_time": "Around 6.5 hours incl. transport and stops",
					"terrain": "Fir forest, fields and rocky mountain path",
					"departure": "8:30 am at the appointed location (Delphi, Chrisso or Itea)",
					"ages": "8+",
					"fitness": "Good and above",
					"story_heading": "History and mythology",
					"story": [
						{
							"heading": "Ancient worship",
							"text": "Sacred since the late Neolithic period (around 4000 BCE), the cave was dedicated to the god Pan, the Corycian Nymphs, and occasionally associated with Dionysus and Zeus."
						},
						{
							"heading": "Mythology",
							"text": "Named after the Naiad nymph Corycia, legend states that Apollo seduced a nymph here who gave birth to their son Lycorus. Aeschylus and Pausanias both wrote of its divine and breathtaking atmosphere."
						},
						{
							"heading": "Wartime refuge",
							"text": "During the Persian invasion of 480 BCE, local residents of Delphi used the cavern as a safe hiding place. It continued to serve as a shelter during later conflicts, including invasions by Turks and Germans."
						},
						{
							"heading": "Archaeological discoveries",
							"text": "Excavations conducted in 1970–1971 by Pierre Amandry (French School of Athens) uncovered thousands of votive offerings, including pottery, bronze figurines, and over 25,000 animal bone astragals (knucklebones) used in ancient rituals. Many findings are exhibited in the Archaeological Museum of Delphi."
						}
					],
					"highlights": [
						{
							"text": "The Corycian Cave"
						},
						{
							"text": "Lovely fir forest hike"
						},
						{
							"text": "Breathtaking view above Delphi"
						}
					],
					"equipment": [
						{
							"item": "Hiking shoes (obligatory)"
						},
