				"slug": "ancient-path",
				"status": "published",
				"data": {
					"title": "The Ancient Path: Delphi to Kirra",
					"lede": "Follow the pilgrims' road from Delphi down to the sea, through a UNESCO-listed grove of 1.5 million olive trees.",
					"difficulty": "EASY",
					"group_size": "8+ people",
